{
  "name": "mixed-signals",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "lint": "oxlint",
    "format": "oxfmt app components/atlas lib db tests scripts *.ts *.json",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.local.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:gateway",
    "test:e2e": "playwright test",
    "globe:generate": "node scripts/generate-globe.mjs",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "eval:verify": "python3 evals/run.py",
    "eval:export": "python3 evals/export.py",
    "check:all": "npm run check && npm run test:python && npm run eval:verify",
    "build:firebase": "vite build --config vite.firebase.config.ts",
    "test:gateway": "node --test firebase/gateway/gateway.test.mjs",
    "test:e2e:firebase": "FIREBASE_E2E=1 playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3-geo": "^3.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.6.0",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9",
    "world-atlas": "^2.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "5.20260910.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "fast-check": "^4.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  },
  "type": "module",
  "description": "A privacy-conscious, seven-day experiment mapping the world\u2019s dating weather.",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
